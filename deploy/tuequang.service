# systemd service unit that keeps Gunicorn running and restarts it on failure
# or reboot.
#
# Install on a server:
#   sudo cp deploy/tuequang.service /etc/systemd/system/tuequang.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now tuequang
#
# Adjust User/Group, WorkingDirectory, and the venv path to match your server.

[Unit]
Description=Tue Quang Shelter website (Gunicorn)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/orphanage_website
# Loads MAIL_*, SECRET_KEY, etc. from the project's .env file.
EnvironmentFile=/opt/orphanage_website/.env
ExecStart=/opt/orphanage_website/venv/bin/gunicorn -c gunicorn.conf.py wsgi:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
