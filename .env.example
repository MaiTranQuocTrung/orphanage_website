# Email settings for the Volunteer & Sponsorship form submissions.
#
# HOW TO USE:
#   1. Copy this file to a new file named ".env" in the same folder.
#   2. Fill in the values below.
#   3. Restart the app (python app.py).
#
# The ".env" file is git-ignored, so your credentials stay private and are
# never committed. If these are left blank, the site still works and form
# submissions are simply logged to the console instead of emailed.

# SMTP server host. For Gmail use: smtp.gmail.com
MAIL_SERVER=

# SMTP port. Use 587 for TLS (recommended) or 465 for SSL.
MAIL_PORT=587

# Use TLS encryption: 1 to enable (recommended), 0 to disable.
MAIL_USE_TLS=1

# The email account used to send the notifications.
MAIL_USERNAME=

# Password for the sending account.
# NOTE: For Gmail you must create an "App Password" (a normal password will
# not work): https://support.google.com/accounts/answer/185833
MAIL_PASSWORD=

# The "From" address shown on the email.
# Optional — defaults to MAIL_USERNAME if left blank.
MAIL_SENDER=

# Where form submissions are delivered.
# Optional — defaults to the address below if left blank.
MAIL_RECIPIENT=tranlananh208c@gmail.com
